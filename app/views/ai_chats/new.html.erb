<div class="container mt-4">
  <h5>チャット</h5>

  <%= form_with url: ai_chat_path, method: :post, data: { turbo: false } do %>
    <div class="mb-3">
      <%= text_area_tag :message, params[:message], class: "form-control", rows:4, placeholder:'メッセージを入力してください' %>
    </div>

    <%= submit_tag "送信", class:"btn btn-primary" %>
  <% end %>

  <% if @reply.present? %>
    <div class="card mt-4">
      <div class="card-body">
        <p><strong>メモリスからの返事</strong></p>
        <%= @reply %>
      </div>
    </div>
  <% end %>
</div>