<!-- main-visual -->
  <div class="main-visual-container mb-4">
  <%= image_tag "memory_mainvisual.webp", class: "img-fluid w-100", style: "height: 400px; object-fit: cover; object-position: center;", alt: "メインビジュアル" %>
    <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-100 px-3">
      <h1 class="display-4 fw-bold mb-3" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.6);">
        memory
      </h1>
      <p class="lead mb-0" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.6);">
        大切な人を失った人が想いを投稿するコミュニティサイト
      </p>
    </div>
  </div>  


<div class="container mt-4">
  <div class="row g-4">

    <div class="col-md-3">
      <div class="card w-100 mt-4 h-100">
        <div class="card-body text-center">
          <p class="mb-2">
            @<%= link_to Current.user.handle_name, user_path(Current.user), class:"text-decoration-none" %>
          </p>

            <%= image_tag @user.get_profile_image(100,100), class: "img-fluid rounded-circle mb-3" %>

            <div>
              <%= link_to "投稿フォーム", new_post_path, class: "btn btn-secondary" %>
            </div>

          </div>
        </div>
      </div>
    

    <div class="col-md-9">
      <div class="card shadow-sm mt-4">
        
        <div class="card-header text-center py-2"> 
          <h6 class="text-muted">応援のつながり</h6>
        </div>

        <div class="card-body">
          
          
          <div class="row text-center mb-4">

            <div class="col-md-6 border-end">
              <%= link_to followers_user_path(@user), class:"text-decoration-none text-dark" do %>
                あなたは
                  <strong class="display-6 mb-1">
                    <%= @user.followers.count %>
                  </strong>
                人に応援されています
              <% end %>
            </div>

            <div class="col-md-6">
              <%= link_to following_user_path(@user), class:"text-decoration-none text-dark" do %>
                あなたが応援している人は
                  <strong class="display-6 mb-1">
                    <%= @user.following.count %>
                  </strong>
                人です
              <% end %>
            </div>
          </div> 
        </div>  
      </div>
    



      <div class="card">
        <div class="card-header text-center py-2">
          <h6 class="text-muted">あなたが参加しているコミュニティ</h6>
        </div>

        <div class="card-body">
          <% if @joined_groups.any? %>    
            <div class="row g-3">
                
              <% @joined_groups.each do |group| %>
                <div class="col-md-4">
                  <div class="card h-100">
                    <div class="card-body text-center">
                      <h6 class="card-title">
                        <%= link_to group.name, group_path(group),class:"text-decoration-none" %>
                      </h6>
                      <%= image_tag group.get_group_image(300, 150), class:"card-img-top", style:"height: 150px; object-fit: cover;" %>
                    </div>
                  </div>
                </div>  
              <% end %>
            <% else %>
              <p class="text-muted">参加しているコミュニティはありません</p>
            <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  
    
    <div class="mt-5">
      <div class="d-flex justify-content-between align-items-center mb-3 bg-light px-3 py-2">
        <h5 class="mb-0">あなたが公開中の投稿</h5>

          <span class="text-muted">
            <%= @posts.count %>件
          </span>
      </div>

      <% if @posts.any? %>
        <div class="row g-4">
          
          <% @posts.each do |post| %>
            <div class="col-md-4">
              <div class="card h-100 shadow-sm">

                <% if post.image.attached? %>
                  <%= image_tag post.image, class:"card-img-top", style:"height: 220px, object-fit: cover;" %>
                <% end %>
                
                <div class="card-body d-flex flex-column">

                  <h5 class="card-title">
                    <%= link_to post.title, post_path(post), class:"text-decoration-none" %>
                  </h5>

                  <p class="card-text"> 
                    <%= truncate(post.body, length: 100) %>
                  </p>

                  <div class="mt-auto">
                    <small class="text-muted">
                      <%= post.created_at.strftime("%Y年%m月%d日") %>
                    </small>
                  </div>
                  
                </div>
              </div>
            </div>

          <% end %>
        </div>
      <% else %>
        <div class="card">
          <div class="card-body text-center">
            公開中の投稿はありません
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>



  
   
<%= image_tag "memorisu.png",class: "character rounded-circle",alt: "イメージキャラクター" %>