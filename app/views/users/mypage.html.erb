<!-- main-visual -->
  <div class="main-visual-container position-relative mb-4">
  <%= image_tag "memory_mainvisual.webp", class: "main-visual-image", alt: "メインビジュアル" %>
    <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-100 px-3">
      <h1 class="main-visual-title fw-bold mb-3">
        memory
      </h1>
      <p class="main-visual-text mb-0">
        大切な人を失った人が<br>想いを投稿するコミュニティサイト
      </p>
    </div>
  </div>  

<!-- ログインユーザー -->
<div class="container mt-4">

  <div class="row g-4">

    <div class="col-12 col-md-3">
      <div class="card w-100 mt-4 h-100">

        <div class="card-header">
          <h6 class="mb-0 text-muted text-center">ログインユーザー</h6>
        </div>

        <div class="card-body text-center">
          <p class="mb-2">
            @<%= link_to Current.user.handle_name, user_path(Current.user), class:"text-decoration-none" %>
          </p>

          <%= image_tag @user.get_profile_image(100,100), class: "img-fluid rounded-circle mb-3" %>

        </div>
      </div>
    </div>
    
                
    <div class="col-12 col-md-9">
    <!-- クイックメニュー -->
      
    <div class="row g-3 mt-4 mb-4">

      <div class="col-6 col-md-3">
        <%= link_to new_post_path, class:"btn btn-primary w-100 h-100 py-3" do %>
          <i class="fa-solid fa-pen-fancy d-block mb-2 text-white"></i>
          投稿する
        <% end %>
      </div>

      <div class="col-6 col-md-3">
        <%= link_to new_group_path, class:"btn btn-success w-100 h-100 py-3" do %>
          <i class="fa-solid fa-users d-block mb-2 text-white"></i>
          コミュニティを作成
        <% end %>
      </div>

      <div class="col-6 col-md-3">
        <%= link_to posts_path, class:"btn btn-secondary w-100 h-100 py-3" do %>
          <i class="fa-solid fa-list d-block mb-2 text-white"></i>
          投稿をみる
        <% end %>
      </div>

      <div class="col-6 col-md-3">
        <%= link_to groups_path, class:"btn btn-secondary w-100 h-100 py-3" do %>
          <i class="fa-solid fa-people-group d-block mb-2 text-white"></i>
          コミュニティをみる
        <% end %>
      </div>

    </div>
     

    <!--つながり/フォロワーとフォロー数 -->          
    <div class="card shadow-sm mt-4 mb-5">
      
      <div class="card-header text-center py-2"> 
        <h6 class="text-muted">つながり</h6>
      </div>

      <div class="card-body">
        
        
        <div class="row text-center mb-4">

          <div class="col-12 col-md-6 connection-item connection-item-first">
            <%= link_to followers_user_path(@user), class:"text-decoration-none text-dark" do %>
              <i class="fa-solid fa-award"></i>
              あなたは
                <strong class="display-6 mb-1">
                  <%= @user.followers.count %>
                </strong>
              人に応援されています
            <% end %>
          </div>

          <div class="col-12 col-md-6 connection-item">
            <%= link_to following_user_path(@user), class:"text-decoration-none text-dark" do %>
              <i class="fa-regular fa-face-smile"></i>
              あなたが応援している人は
                <strong class="display-6 mb-1">
                  <%= @user.following.count %>
                </strong>
              人です
            <% end %>
          </div>
        </div> 
      </div>  
    </div>
    


    <!-- 参加コミュニティ一覧 -->
    <div class="card">
      <div class="card-header text-center py-2">
        <h6 class="text-muted">あなたが参加しているコミュニティ</h6>
      </div>

      <div class="card-body">
        <% if @joined_groups.any? %>  
          <div class="d-flex gap-3 horizontal-scroll flex-nowrap pb-3">
              
            <% @joined_groups.each do |group| %>
              <div class="joined-group-item">
                <div class="card h-100">
                  
                  <%= image_tag group.get_group_image(300, 150), class:"card-img-top joined-group-image" %>
                  
                  <div class="card-body text-center">
                    <h6 class="card-title mb-0">
                      <%= link_to group.name, group_path(group),class:"text-decoration-none" %>
                    </h6>
                  </div>
                    
                </div>
              </div> 
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">参加しているコミュニティはありません</p>
        <% end %>
      </div>
    </div>
  </div>
  
  
    <!-- ユーザーの公開中投稿 -->
    <div class="mt-5">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 bg-light px-3 py-2">
        <h5 class="mb-0">あなたが公開中の投稿</h5>

          <span class="text-muted ">
            <%= @posts.count %>件
          </span>
      </div>

      <% if @posts.any? %>
        <div class="row g-4">
          
          <% @posts.each do |post| %>
            <div class="col-12 col-lg-4 col-sm-6">
              <div class="card h-100 shadow-sm">

                <% if post.image.attached? %>
                  <%= image_tag post.image, class:"card-img-top post-card-image" %>
                <% end %>
                
                <div class="card-body d-flex flex-column">

                  <h5 class="card-title">
                    <%= link_to post.title, post_path(post), class:"text-decoration-none" %>
                  </h5>

                  <p class="card-text"> 
                    <%= truncate(post.body, length: 100) %>
                  </p>

                  <div class="mt-auto">
                    <small class="text-muted">
                      <%= post.created_at.strftime("%Y年%m月%d日") %>
                    </small>
                  </div>
                  
                </div>
              </div>
            </div>

          <% end %>
        </div>
      <% else %>
        <div class="card">
          <div class="card-body text-center">
            公開中の投稿はありません
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

