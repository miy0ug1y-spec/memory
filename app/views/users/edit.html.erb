<% if @user.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

      <h5>ユーザー編集</h5>

      <%= form_with model: @user do |f| %>
        <div class="card mt-4">
          <div class="card-body">

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <%= f.label :last_name, "姓", class:"form-label" %>
              <%= f.text_field :last_name, class:"form-control" %>
            </div>

            <div class="col-12 col-md-6">
              <%= f.label :first_name, "名前", class:"form-label" %>
              <%= f.text_field :first_name, class:"form-control" %>
            </div>

            <div class="mt-3">
              <%= f.label :gender, "性別", class:"form-label d-block" %>

              <div class="form-check form-check-inline">
                <%= f.radio_button :gender, :male, class:"form-check-input" %>
                <%= f.label :gender_male, "男性", class:"form-check-label" %>
              </div>

              <div class="form-check form-check-inline">
                <%= f.radio_button :gender, :female, class:"form-check-input" %>
                <%= f.label :gender_female, "女性", class:"form-check-label" %>
              </div>
            </div>

            <div class="mt-3">
              <%= f.label :birthday, "生年月日", class:"form-label" %>
              <%= f.date_field :birthday, class:"form-control" %>
            </div>

            <div class="mt-3">
              <%= f.label :handle_name, "ハンドルネーム", class:"form-label" %>
              <%= f.text_field :handle_name, autofocus: true, placeholder:"ハンドルネーム", class:"form-control" %>
            </div>

            <div class="mt-3">
              <%= f.label :image, "ユーザーイメージ", class:"form-label" %>

              <% if @user.image.attached? %>
                <div class="mb-2">
                  <%= image_tag @user.get_profile_image(150,150), class:"rounded-circle user-edit-image" %>
                </div>
              <% end %>

              <p class="text-muted small">
                画像を変更する場合のみ選択してください
              </p>

              <%= f.file_field :image, accept: "image/*", class:"form-control" %>

            </div>

            <div class="mt-4">
              <%= f.label :introduction, "自己紹介文", class:"form-label" %>
              <%= f.text_area :introduction, class:"form-control", rows: 3 %>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-md-between gap-2 mt-4">
              <%= f.submit "変更を保存", class:"btn btn-primary" %> 
              <%= link_to "退会する",withdraw_user_path(@user), data: { turbo_method: :patch, turbo_confirm: "本当に退会しますか？"}, class:"btn btn-outline-danger" %> 
            </div>

          </div>
        </div>
      <% end %>
      
    </div>
    <div class="mt-3">
        <%= link_to "＜ マイページへ",mypage_path %>
      </div>
  </div>
</div>    
