<div class="container mt-4"> 

  <div class="d-flex justify-content-center bg-light px-3 py-2 mb-3">
    <h5 class="follow-list-title mb-0">
      あなたが応援しているユーザー一覧
    </h5>
  </div>

  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

      <div class="card shadow-sm mt-4">
        <div class="card-body follow-list-body">

          <% if @users.any? %>

            <div class="row g-4">
              <% @users.each do |user| %>

                <div class="col-6 col-sm-4 col-md-3">
                  <div class="text-center">

                    <%= image_tag user.get_profile_image(60, 60), class:"member-image rounded-circle" %>
              
                    <%= link_to user.handle_name, user_path(user), class:"text-decoration-none text-dark fw-semibold" %>

                  </div>
                </div>
            
              <% end %>
            </div>

            <div class="d-flex justify-content-center mt-4">
              <%= paginate @users %>
            </div>

          <% else %>
            <p>まだ応援している人はいません</p>
          <% end %>
          
        </div>
      </div>

      <div class="mt-3">      
        <%= link_to "＜  戻る", mypage_path %>
      </div>
    </div>
  </div>
</div>
