<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <h5>ユーザー詳細</h5>

      <div class="card mt-4"> 
        <div class="card-body">

          <div class="row align-items-center">
            <div class="col-md-4">
              <div class="text-center">
                <%= image_tag @user.get_profile_image(100,100), class: "user-avatar rounded-circle" %>
                <div class="fw-semibold">
                  <%= @user.handle_name %>
                </div>
              </div>
            </div>
            
            <div class="col-md-8 d-flex flex-column mt-2">
              
              <% if @user.introduction.present? %>
                <%= simple_format(@user.introduction) %>
              <% else %>
                <p>まだ自己紹介はありません</p>
              <% end %>

              <div class="d-flex justify-content-end">
                <p class="me-2"><i class="fa-solid fa-award"></i><%= @user.followers.count %></p>
                <p><i class="fa-regular fa-face-smile"></i><%= @user.following.count %></p>
              </div>

              <% if authenticated? && Current.user != @user %>

              <% relationship = Current.user.active_relationships.find_by(followed: @user) %>
                <div class="mt-auto text-end">
                  <% if relationship %> 
                    <%= button_to "解除する", relationship_path(relationship), method: :delete, class:"btn btn-outline-secondary" %>
                  <% else %>
                    <%= button_to "応援する", relationships_path(followed_id: @user.id), method: :post, class:"btn btn-outline-primary" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

            <div class="d-flex justify-content-end">
              <% if Current.user && @user == Current.user %>
                <%= link_to "ユーザー編集", edit_user_path(@user), class:"btn btn-outline-primary" %>
              <% end %>
            </div>
          </div> 
        </div>
      </div>

      <div class="mt-5">

        <div class="d-flex justify-content-between align-items-center mb-3 bg-light px-3 py-2">
          <h5 class="mb-0">
            <%= @user.handle_name %>さんの投稿
          </h5>

          
          <span class="text-muted">
            <strong>
              <%= @posts.count %>件
            </strong>
          </span>
        </div>
          
        <% if @posts.any? %>
          <div class="row g-4">

            <% @posts.each do |post| %>
              <div class="col-md-4">

                <div class="card h-100 shadow-sm">
                  <% if post.image.attached? %>
                    <%= image_tag post.image, class:"card-img-top", style:"height:200px; object-fit: cover;" %>
                  <% end %>
                  
                  <div class="card-body d-flex flex-column">
                    <h5>
                      <%= link_to post.title, post_path(post), class:"text-decoration-none" %>
                    </h5>

                    <p>
                      <%= truncate(post.body, length: 80) %>
                    </p>

                    <div class="ms-auto">
                      <small class="text-muted">
                        <%= post.created_at.strftime("%Y年%m月%d日") %>
                      </small>
                    </div>

                  </div>
                </div>
              </div>
            <% end %>
          </div>

        <% else %>
          <p class="text-center">公開中の投稿はまだありません</p>
        <% end %>  
      </div>
    </div>
    <%= link_to "＜ マイページへ", mypage_path %>
  </div> 
</div>

