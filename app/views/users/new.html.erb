<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="h4 text-center mb-4">
            サインアップ
          </h2>

          <%= form_with model: @user, url: users_path do |f| %>
            <% if @user.errors.any? %>

              <div class="alert alert-danger">
                <ul class="mb-0">

                  <% @user.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>

                </ul>
              </div>
            <% end %>

            <div class="row g-3">

              <div class="col-12 col-md-6">
                <%= f.label :last_name, "姓", class:"form-label" %>
                <%= f.text_field :last_name, autofocus: true, class:"form-control" %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :first_name, "名前", class:"form-label" %>
                 <%= f.text_field :first_name, class:"form-control" %>
              </div>
            </div>

            <div class="mt-3">
              <%= f.label :gender, "性別", class:"form-label d-block" %>

              <div class="form-check form-check-inline">
                <%= f.radio_button :gender, :male, class:"form-check-input" %>
                <%= f.label :gender_male, "男性", class:"form-check-label" %>
              </div>

              <div class="form-check form-check-inline">
                <%= f.radio_button :gender, :female, class:"form-check-input" %>
                <%= f.label :gender_female, "女性", class:"form-check-label" %>
              </div>
            </div>

            <div class="mt-3">
              <%= f.label :birthday, "生年月日", class:"form-label" %>
              <%= f.date_field :birthday, class:"form-control" %>
            </div>

            <div class="mt-3">
              <%= f.label :handle_name, "ハンドルネーム", class:"form-label" %>
              <%= f.text_field :handle_name, class:"form-control" %>
            </div>

            <div class="mt-3">
              <%= f.label :email_address, "メールアドレス", class:"form-label" %>
              <%= f.email_field :email_address, class:"form-control" %>
            </div>

            <div class="mt-3">
              <%= f.label :password, "パスワード", class:"form-label" %>
              <%= f.password_field :password, class:"form-control" %>
            </div>

            <div class="d-grid mt-3">
              <%= f.submit "サインアップ", class:"btn btn-primary" %>
            </div>
          <% end %>

          <div class="text-center mt-3">
            <%= link_to "ログインはこちらから", new_session_path %>
          </div>

        </div>
      </div>
    </div>
  </div>

</div>
