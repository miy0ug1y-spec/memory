<!main-visual>
   <div class="main-visual-container position-relative mb-4">
   <%= image_tag "memory_mainvisual.webp", class: "main-visual-image", alt: "メインビジュアル" %>
     <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-100 px-3">
    <h1 class="main-visual-title fw-bold mb-3">
      memory
    </h1>
    <p class="main-visual-text mb-0">
      大切な人を失った人が<br>想いを投稿するコミュニティサイト
    </p>
  </div>
</div>        


<!--top -->
<div class="container mt-4">

    <% @genres.each do |genre| %>
      <% genre_posts = genre.posts.published.order(created_at: :desc) %> 
      <% posts = genre_posts.limit(3) %>


        <section class="mb-5">
         
            <div class="d-flex justify-content-between align-items-center bg-light px-3 py-2 mb-3">
              <h4 class="mb-0"><%= genre.name %>に関する投稿</h4>
              <% if genre_posts.count > 3 %>
                <%= link_to "もっと見る  ＞",posts_path(genre_id: genre.id), class:"text-decoration-none text-dark" %>
              <% end %>
            </div>
         
          <% if posts.any? %>
            <div class="row">
              <% posts.each do |post| %>
                <div class="col-md-4 mb-3">
                  <div class="card h-100">
                    <div class="card-body">

                      <div class="d-flex align-items-center mb-2">
                        <%= image_tag post.user.get_profile_image(100,100), size: "70x70", class: "rounded-circle me-2" %>
                        <%= link_to post.user.handle_name, user_path(post.user),class: "text-decoration-none" %>
                      </div>

                      <% if post.within_one_week? %>
                        <%= image_tag "new.jpg", size: "80x80", class:"img-fluid" %>
                      <% end %>

                      <h5>
                      <%= link_to post.title, post_path(post) %>
                      </h5>

                      <p class="post-preview">
                        <%= truncate(post.body, length: 70) %>
                      </p>
                    
                      <% if post.image.attached? %>
                        <%= image_tag post.image, class: "img-fluid", style: "width: 100%; height: 250px; object-fit: cover;" %>
                      <% end %>

                      <div class="mt-2">
                        <small class="text-muted">
                          <%= post.created_at.strftime("%Y年%m月%d日 %H:%M") %>
                        </small>
                      </div>

                      <div>
                        <small class="text-muted">
                          <%= post.genre&.name ||"ジャンル設定なし" %>
                        </small>
                      </div>

                  </div>
                </div>
              </div> 
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">
            まだこのジャンルには投稿がありません
          </p> 
        <% end %>
      </section>
    <% end %>
  </div>
  
<section class="group-section py-4">
  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="border-start border-4 border-primary ps-3">コミュニティ</h3>

      <% if Group.count > 3 %>
        <%= link_to "すべてみる  ＞", groups_path, class:"text-decoration-none text-dark" %>
      <% end %>
    </div>  
    
    <% if @groups.any? %>
      <div class="row g-3">
        <% @groups.each do |group| %>
          <div class="col-md-4">
            
            <div class="card mb-3 border-0 shadow-sm">
              <div class="card-body d-flex justify-content-between align-items-center">

                <div>
                  <h5 class="card-title" >
                    <%= link_to group.name, group_path(group), class:"text-decoration-none text-dark" %>
                  </h5>
                    <%= image_tag group.get_group_image(300, 200), class:"img-fluid rounded mb-3", style:"width: 100; height: 200px; object-fit: cover;" %>
                </div>

                <%= link_to "詳細", group_path(group), class:"btn btn-primary ms-3" %>

              </div>
            </div>
          </div>
        <% end %>

      </div>
    <% else %>
      <p class="text-muted">まだコミュニティがありません</p>
    <% end %>
  </div>
</section>

  

        
    

    

