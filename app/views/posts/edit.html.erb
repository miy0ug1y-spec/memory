
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

    <% if @post.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <h5>編集画面</h5>
      
      <%= form_with model: @post do |f| %>
        
        <div class="card mt-4">
          <div class="card-body">

            <div class="mb-3">
              <%= f.label :title, "タイトル", class:"form-label" %>
              <%= f.text_field :title, class:"form-control" %>
            </div>
            
            <div class="mb-3">
              <%= f.label :body, "本文", class:"form-label" %>
              <%= f.text_area :body, class:"form-control", rows: 5 %>
            </div>

            <div class="mb-3">
              <%= f.label :image, "画像", class:"form-label" %>

              <% if @post.image.attached? %>
                <div class="mb-3">
                  <%= image_tag @post.image, class: "post-edit-image rounded" %>
                </div>

                <div class="form-check  mb-3">
                  <%= check_box_tag :remove_image, "1", false, class:"form-check-input" %>
                  <%= label_tag :remove_image, "画像を削除する", class:"form-check-label" %>
                </div>
              <% end %>

              <%= f.file_field :image, class:"form-control" %>  
            </div>

        

            <div class="mb-3">
              <%= f.label :is_publish, "公開設定",class:"form-label d-block" %>

                <div class="form-check form-check-inline">
                  <%= f.radio_button :is_publish, true, class: "form-check-input", id: "post_is_publish_true" %>
                  <%= f.label :is_publish_true, "公開", class: "form-check-label", for: "post_is_publish_true" %>
                </div>

                <div class="form-check form-check-inline">
                  <%= f.radio_button :is_publish, false, class: "form-check-input", id: "post_is_publish_false" %>
                  <%= f.label :is_publish_false, "非公開", class: "form-check-label", for: "post_is_publish_false" %>
                </div>
              </div>

              <div class="mb-3">
                <%= f.label :genre_id, "ジャンル選択",class:"form-label" %>
                <%= f.collection_select :genre_id, @genres, :id, :name, {}, class:"form-select" %>
              </div>

            </div>
          </div>
                  
          <div class="d-flex flex-column flex-md-row justify-content-md-between gap-2 mt-4">
            <%= f.submit '保存', class:"btn btn-primary" %>
            <%= link_to "削除", post_path(@post),  data: { turbo_method: :delete, turbo_confirm: "本当に削除？" } , class:"btn btn-outline-danger" %>
          </div>        
        </div>
      <% end %>   
      <div class="mt-3">
        <%= link_to "＜ MyPOSTへ", mypost_path %>
      </div>
    </div>
  </div>
</div>
