<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

      <div class="d-flex justify-content-between align-items-center mb-4 bg-light px-3 py-2">
        <h5 class="mb-0">わたしだけの投稿一覧</h5>

        <span class="text-muted small">
          <%= @posts.total_count %>件
        </span>
      </div>

      <% if @posts.any? %>
        <div class="diary-list">

          <% @posts.each do |post| %>

            <article class="diary-entry">

              <div class="diary-date">
                <span class="diary-day">
                  <%= post.created_at.strftime("%-m/%-d") %>
                </span>
                <span>
                  <%= post.created_at.strftime("%Y") %>
                </span>
              </div>

              <div class="diary-content">
                
                <h5 class="diary-title">
                  <%= link_to post.title, post_path(post), class:"text-decoration-none" %>
                </h5>

                <p class="diary-body">
                  <%= truncate(post.body, length: 200) %>
                </p>

                <% if post.image.attached? %>
                  <%= image_tag post.image, class: "diary-image rounded" %>
                <% end %>

                <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">
                  <small class="text-muted">
                    <i class="fa-solid fa-tag me-1"></i>
                    <%= post.genre&.name ||"ジャンル設定なし" %>
                  </small>

                  <small class="text-muted">
                    <%= post.created_at.strftime("%H:%M") %>
                  </small>

                </div>
              </div>
                
            </article>
          <% end %>

          <div class="d-flex justify-content-center mt-4">
            <%= paginate @posts %>
          </div>

        </div>
      <% else %>
        <div class="diary-empty mt-4 text-center">
          <p class="mb-0">
            自分だけに書いている投稿はありません
          </p>
        </div> 
      <% end %>


      <div class="mt-4">
        <%= link_to "＜ マイページへ", mypage_path %>
      </div>
    </div> 
  </div>
</div>

<%= image_tag "memorisu.png", class:"character rounded-circle", alt: "イメージキャラクター" %>

