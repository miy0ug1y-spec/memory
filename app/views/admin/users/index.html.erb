<div class="container mt-4">
  <h4 class="mb-4">ユーザー一覧</h4>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>氏名</th>
            <th>性別</th>
            <th>生年月日</th>
            <th>ハンドルネーム</th>
            <th>メールアドレス</th>
            <th>登録日</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.id %></td>

              <td>
                <%= user.last_name %>
                <%= user.first_name %>
              </td>

              <td><%= user.gender_japanese %></td>

              <td><%= user.birthday&.strftime("%Y/%m/%d") || "未設定" %></td>

              <td><%= user.handle_name %></td>

              <td><%= user.email_address %></td>

              <td><%= user.created_at.strftime("%Y/%m/%d") %></td>

              <td>
                <%= link_to "詳細", admin_user_path(user), class:"btn btn-outline-primary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <%= link_to "＜  ダッシュボードに戻る", admin_dashboard_path %>
</div>