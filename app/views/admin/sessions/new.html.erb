<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-6 col-lg-4">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="h4 text-center mb-4">
            管理者ログイン
          </h2>

          <% if flash[:alert] %>
            <div class="alert alert-danger">
              <%= flash[:alert] %>
            </div>
          <% end %>

          <%= form_with url: admin_session_path, scope: :session do |f| %>
            <div class="mb-3">
              <%= f.label :email_address, "メールアドレス", class:"form-label" %>
              <%= f.email_field :email_address, required: true, autofocus: true, class:"form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, "パスワード", class:"form-label" %>
              <%= f.password_field :password, required: true, class:"form-control" %>
            </div>

            <div class="d-grid">
              <%= f.submit "ログイン", class:"btn btn-primary" %>
            </div>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>