<div class="container mt-4">
  <h4 class="mb-4">投稿一覧</h4>

  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>タイトル</th>
          <th>投稿者</th>
          <th>ジャンル</th>
          <th>投稿日</th>
          <th>公開状態</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td><%= post.id %></td>

            <td><%= truncate(post.title, length: 30) %></td>

            <td><%= post.user.handle_name %></td>

            <td><%= post.genre&.name || "-" %></td>

            <td><%= post.created_at.strftime("%Y/%m/%d %H:%M") %></td>

            <td>
              <% if post.is_publish? %>
                <span class="badge bg-success">公開</span>
              <% else %>
                <span class="badge bg-secondary">非公開</span>
              <% end %>
            </td>

            <td>
              <%= link_to "詳細", admin_post_path(post), class:"btn btn-outline-primary btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @posts %>
  </div>

  <%= link_to "＜  ダッシュボードに戻る", admin_dashboard_path %>
</div>