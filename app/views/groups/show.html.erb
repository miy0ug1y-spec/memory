<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card mt-3 mb-4">
        <div class="card-body">

          <div class="group-image-wrapper">

            <h5 class="group-title"><%= @group.name %></h5>

            <%= image_tag @group.get_group_image(300, 200), class:"img-fluid rounded w-100 group-image" %>

          </div>

          <p><%= @group.introduction %></p>

          <p>参加者数：<%= @group.members.count %>人</p>

          <% if @group.members.any? %>
            <div class="member-scroll">

              <% @group.members.each do |member| %>
                <%= link_to user_path(member), class:"member-item text-decoration-none text-dark" do %>

                <%= image_tag member.get_profile_image(50,50), class:"rounded-circle member-image" %>

                <span class="member-name">
                  <%= member.handle_name %>
                </span>

              <% end %>
            <% end %>
          </div>
        <% end %> 
         
        <div class="d-flex justify-content-end mb-3">
          <small>コミュニティ作成者：<%= link_to @group.owner.handle_name, user_path(@group.owner), class:"text-decoration-none" %></small>
        </div>

        <div class="d-flex justify-content-end">
          <% if Current.user == @group.owner %>

            <%= link_to "編集", edit_group_path(@group), class:"btn btn-outline-primary btn-sm" %>
          
          <% elsif @group.members.exists?(Current.user.id) %>

            <%= button_to "コミュニティから退出", group_group_membership_path(@group), method: :delete, class:"btn btn-outline-danger" %>

          <% else %>

            <%= button_to "コミュニティに参加", group_group_membership_path(@group), method: :post, class:"btn btn-primary" %>

          <% end %>
        </div>
       </div>
      </div>
   


      <div class="card mt-4 shadow-sm">
        <div class="card-body">
          <h5 class="bg-success px-3 py-2 rounded mb-3 text-white">コミュニティ掲示板</h5>

          <div class="message-list mb-4">
            <% @messages.each do |message| %>
              <div class="d-flex mb-3">

                <%= image_tag message.user.get_profile_image(45, 45), class:"rounded-circle me-2 message-user-image" %>

                <div class="message-box">
                  <div class="d-flex align-items-center gap-2 mb-1">

                    <strong>
                      <%= link_to message.user.handle_name, user_path(message.user), class:"text-decoration-none text-dark" %>
                    </strong>

                    <small class="text-muted">
                      <%= message.created_at.strftime("%Y年%m月%d日 %H:%M") %>
                    </small>
                  </div>

                  <%= simple_format(message.content, class:"mb-1") %>

                    <div class="d-flex justify-content-end">
                      <% if message.user == Current.user || @group.owner == Current.user %>
                        <%= link_to "削除", group_group_message_path(@group, message), data: { turbo_method: :delete, turbo_confirm: "メッセージを削除しますか？"}, class:"small text-danger" %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
            
            <% if @group.members.exists?(Current.user.id) %>
              <%= form_with model: [@group, @message] do |f| %>

                <% if @message.errors.any? %>
                  <div class="alert alert-danger">
                    <%= @message.errors.full_messages.join("、") %>
                  </div>
                <% end %>

                <%= f.text_area  :content, class:"form-control", rows: 2, placeholder:"メッセージを入力する" %>

                <div class="d-flex justify-content-end mt-2">
                  <%= f.submit "投稿", class:"btn btn-primary fw-bold" %>
                </div>

              <% end %>
            <% else %>
              <p class="text-muted">メッセージを投稿する場合はコミュニティに参加してください</p>
            <% end %>
          </div>
        </div>
      
        <div class="mt-4">
          <%= link_to "＜  コミュニティ一覧",groups_path %>
        </div>

        
      </div>
    </div>
  </div>
</div>

