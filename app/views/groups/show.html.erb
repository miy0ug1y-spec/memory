<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card mt-3 mb-4">
        <div class="card-body">

          <h5 class="text-center"><%= @group.name %></h5>

          <p><%= @group.introduction %></p>

          <p>参加者数：<%= @group.members.count %>人</p>

          <% if @group.members.any? %>
            <div class="member-scroll">

              <% @group.members.each do |member| %>
                <%= link_to user_path(member), class:"member-item text-decoration-none text-dark" do %>

                <%= image_tag member.get_profile_image(50,50), class:"rounded-circle member-image" %>

                <span class="member-name">
                  <%= member.handle_name %>
                </span>

              <% end %>
            <% end %>
          </div>
        <% end %> 

        <small>コミュニティ作成者：<%= link_to @group.owner.handle_name, user_path(@group.owner) %></small>

        <div class="d-flex justify-content-end">
          <% if Current.user == @group.owner %>

            <%= link_to "編集", edit_group_path(@group), class:"btn btn-outline-primary btn-sm" %>
          
          <% elsif @group.members.exists?(Current.user.id) %>

            <%= button_to "コミュニティから退出", group_membership_path(@group), method: :delete, class:"btn btn-outline-danger" %>

          <% else %>

            <%= button_to "コミュニティに参加", group_membership_path(@group), method: :post, class:"btn btn-primary" %>

          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>

  <%= link_to "＜  トップページに戻る",root_path %>

</div>

