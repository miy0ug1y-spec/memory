<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
      <h5>コミュニティ編集画面</h5>

      <div class="card mb-3 mt-4">
        <div class="card-body">
          <%= form_with model:@group do |f| %>
            
            <p>名前</p>
            <%= f.text_field :name, class:"form-control" %>

            <p class="mt-3">コミュニティ画像</p>

            <% if @group.image.attached? %>
              <div class="mb-3">
                <%= image_tag @group.get_group_image(300, 200), class:"img-fluid rounded group-edit-image" %>
              </div>

              <div class="form-check mb-3">
                <%= check_box_tag :remove_image, "1", false, class:"form-check-input" %>
                <%= label_tag :remove_image, "現在の画像を削除する", class:"form-check-label" %>
              </div>
            <% end %>           

            <%= f.file_field :image, class:"form-control" %>

            <p class="mt-3">コミュニティ紹介</p>
            <%= f.text_area :introduction, class:"form-control", rows: 5 %>

            <div class="d-flex flex-column flex-md-row justify-content-md-between gap-2 mt-4">
              <%= f.submit "保存", class:"btn btn-primary" %>
              <%= link_to "削除", group_path(@group),data: { turbo_method: :delete, turbo_confirm: "本当に削除？" } , class:"btn btn-sm btn-outline-danger" %>
            </div>

          <% end %>
        </div>
      </div>


    </div>
  </div>
  <%= link_to "詳細ページへ戻る", group_path(@group) %>
</div>