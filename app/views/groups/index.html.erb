<div class="container mt-4">
  <div class="d-flex justify-content-center bg-light px-3 py-2 mb-3">
    <h5>コミュニティ一覧</h5>
  </div>

 
  <div class="row justify-content-center">
    <div class="col-md-8">

      <% if @groups.any? %>
        <% @groups.each do |group| %>

          <div class="card shadow-sm mt-3 mb-4">
            <div class="card-body">

              <h4>
                <%= group.name %>
              </h4>
              
              <p>
                <%= truncate(group.introduction, length: 100) %>
              </p>
              
              <p class="text-muted">
                参加者数：<%= group.members.count %>
              </p>

              <div class="d-flex justify-content-end">
                <%= link_to "詳細", group_path(group), class:"btn btn-outline-primary" %>
              </div>

            </div>
          </div>
        <% end %>
      <% else %>
        <p>まだコミュニティがありません</p>
      <% end %>
     
    </div>
  </div>
  <%= link_to "＜  トップページに戻る", root_path %>
</div>