<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <h5>コミュニティ作成</h5>

      <%= form_with model: @group do |f| %>
        <% if @group.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @group.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="card mb-3 mt-4">
          <div class="card-body">
            <div class="mb-3">
              <%= f.label :name, "コミュニティ名", class: "form-label" %>

              <%= f.text_field :name, class: "form-control" %>

            </div>

            <div class="mb-3">
              <%= f.label :introduction, "コミュニティ紹介", class: "form-label" %>

              <%= f.text_area :introduction, class: "form-control", rows: 5 %>
            
            </div>

            <div class="d-flex justify-content-end">
              <%= f.submit "コミュニティを作成", class: "btn btn-primary" %>
            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>