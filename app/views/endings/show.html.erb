<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

      <h5>MyENDING</h5>
        <div class="card mb-3 mt-4">
          <div class="card-body">
          <p>氏名</p>
            <%= @ending.user.last_name %>
            <%= @ending.user.first_name %>
            <%= @ending.user.gender_japanese %>
          <p class="mt-4">生年月日</p>
            <%= @ending.user.birthday %>
          <p class="mt-4 text-center mb-2">大切な人に伝えたいことや感謝の気持ち</p>
            <%= simple_format(@ending.feeling) %>
            
            <% if @ending.image.attached? %>

              <% if @ending.image.image? %>
               <%= image_tag @ending.image, class:"ending-image rounded" %>
              <% elsif @ending.image.video? %>
                <%= video_tag url_for(@ending.image), controls: true, class:"ending-video rounded" %>
              <% end %>

            <% end %>
            
            <p class="mt-4 text-center mb-2">エピソード<br>
              ー忘れられない記憶や懐かしい思い出ー
            </p>
            
            <%= simple_format(@ending.episode) %>

            <p class="mt-4 text-center mb-2">memoryのあしあと</p>
              <% @ending.posts.each do |post| %>
                <div class="card mb-3 mt-4">
                  <div class="card-body">
                    <h5><%= post.title %></h5>
                    <p><%= simple_format(post.body) %></p>
                    <% if post.image.attached? %>
                      <%= image_tag post.image, class: "rounded ending-post-image" %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>          
          </div>
    
        <div class="mt-3 d-flex flex-column flex-md-row justify-content-md-between align-items-start gap-2">
          <% if Current.user.ending %>

            <%= link_to "編集", edit_ending_path(@ending), class:"btn btn-outline-primary ending-action-btn " %>
            
            <div class="ending-pdf-action text-md-end">
              <%= link_to download_ending_path(@ending), class:"btn btn-success fw-bold ending-action-btn", target: "_blank", rel: "noopener" do %>

                <i class="fa-regular fa-file text-white"></i>
                PDFを表示

              <% end %>

              <p class="text-muted small mt-1 mb-0">
                動画はQRコードとして表示されます
              </p>
            </div>

          <% end %>
        </div>
      </div>
    <%= link_to "＜ マイページへ", mypage_path %>
  </div>
  