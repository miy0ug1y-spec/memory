<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

      <h5>MyENDINGを作成</h5>

      <%= form_with model: @ending do |f| %>

        <div class="card mb-3 mt-4">
          <div class="card-body">
            <h6>名前</h6>
            
            <% if Current.user %>

              <%= Current.user.last_name %>
              <%= Current.user.first_name %>
              <%= Current.user.gender_japanese %>

              <h6 class="mt-4">生年月日</h6>
              <%= Current.user.birthday %>

            <% end %>

            <h6 class="mt-4 text-center">大切な人に伝えたいことや感謝の気持ち</h6>
            
            <%= f.text_area :feeling, class:"form-control", rows: 5 %>
          
            <h6 class="mt-4"> 動画・画像</h6>
            
            <%= f.file_field :image, class:"form-control" %>
          

            <h6 class="mt-4 text-center">エピソード<br>ー忘れられない記憶や懐かしい思い出ー</h6>
            
            <%= f.text_area :episode, class:"form-control", rows: 5 %>

            <h6 class="mt-4 text-center">memoryのあしあと</h6>
            <p class="text-muted mt-2">MyEndingに載せたい投稿があれば選択してください</p>

            <%= f.collection_check_boxes :post_ids, @posts, :id, :title do |b| %>
            
              <div class="card mb-3">
                <div class="card-body">
                  <div class="form-check mb-2">
                    <%= b.check_box class: "form-check-input" %>

                    <%= b.label class: "form-check-label fw-bold" do %>
                      この投稿を選択
                    <% end %>

                    <h5><%= b.object.title %></h5>
                    <p><%= b.object.body %></p>

                    <% if b.object.image.attached? %>
                      <%= image_tag b.object.image, class: "rounded ending-select-image" %>
                    <% end %>

                  </div>
                </div>
              </div>
            <% end %>
          </div>

        </div>
        <div class="d-grid d-md-flex justify-content-md-end m-2">
          <%= f.submit "保存", class:"btn btn-primary" %>
        </div>
      <% end %>
    </div>

  </div>
</div>




